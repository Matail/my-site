---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
	d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Layout
	title={`${post.data.title} · my-site`}
	description={post.data.description}
	active="blog"
	width="narrow"
>
	<article class="post">
		<header class="post-head" data-reveal>
			<a href="/blog" class="back">← 작업 기록</a>

			<div class="meta">
				<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
				{
					post.data.updatedDate && (
						<span class="updated">수정 {fmt(post.data.updatedDate)}</span>
					)
				}
				{
					post.data.tags && post.data.tags.length > 0 && (
						<div class="tags">
							{post.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)
				}
			</div>

			<h1>{post.data.title}</h1>
			<p class="lead">{post.data.description}</p>
		</header>

		<div class="prose" data-reveal style="--reveal-delay: 120">
			<Content />
		</div>

		<footer class="post-foot" data-reveal style="--reveal-delay: 160">
			<a href="/blog" class="btn btn-ghost">다른 글 보기</a>
			<a href="/games" class="btn btn-lamp">게임 플레이</a>
		</footer>
	</article>
</Layout>

<style>
	.post {
		padding: clamp(2.5rem, 7vw, 4.5rem) 0 2rem;
	}

	.back {
		display: inline-block;
		font-size: 0.85rem;
		color: var(--text-mute);
		margin-bottom: 2.5rem;
	}

	.back:hover {
		color: var(--lamp);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.meta time,
	.updated {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--text-mute);
	}

	.tags {
		display: flex;
		gap: 0.35rem;
	}

	.post-head h1 {
		font-size: clamp(2rem, 5.5vw, 3.1rem);
		margin: 0 0 1rem;
	}

	.post-head .lead {
		font-size: 1.05rem;
		margin: 0 0 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}

	/* ===== 본문 ===== */
	.prose {
		font-size: 1.02rem;
		line-height: 1.85;
		color: #DCD9D3;
	}

	.prose :global(h2) {
		font-size: 1.45rem;
		margin: 2.75rem 0 0.85rem;
		color: var(--text);
	}

	.prose :global(h3) {
		font-size: 1.15rem;
		margin: 2rem 0 0.6rem;
		color: var(--text);
	}

	.prose :global(p) {
		margin: 0 0 1.35rem;
	}

	.prose :global(a) {
		color: var(--lamp);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.35rem;
		padding-left: 1.3rem;
	}

	.prose :global(li) {
		margin-bottom: 0.45rem;
	}

	.prose :global(li)::marker {
		color: var(--lamp);
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.86em;
		background: var(--surface-3);
		border: 1px solid var(--border);
		padding: 1px 6px;
		border-radius: 6px;
		color: var(--lamp-soft);
	}

	.prose :global(pre) {
		background: var(--surface);
		border: 1px solid var(--border);
		padding: 1.1rem 1.25rem;
		border-radius: var(--r-md);
		overflow-x: auto;
		margin: 1.75rem 0;
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.prose :global(pre code) {
		background: none;
		border: none;
		padding: 0;
		color: var(--text);
		font-size: 1em;
	}

	.prose :global(blockquote) {
		margin: 1.75rem 0;
		padding: 0.25rem 0 0.25rem 1.1rem;
		border-left: 2px solid var(--lamp);
		color: var(--text-dim);
	}

	.prose :global(img) {
		max-width: 100%;
		border-radius: var(--r-md);
		border: 1px solid var(--border);
		margin: 1.75rem 0;
	}

	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--border);
		margin: 2.5rem 0;
	}

	/* ===== 글 아래 ===== */
	.post-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
</style>
