---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
	d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Layout
	title="작업 기록 — my-site"
	description="게임 만들면서 마주친 문제와 그걸 푸는 과정을 기록합니다."
	active="blog"
	width="narrow"
>
	<section class="head">
		<p class="kicker" data-reveal>DEVLOG</p>
		<h1 data-reveal style="--reveal-delay: 80">
			만든 것,<br />
			<span class="accent">배운 것.</span>
		</h1>
		<p class="lead" data-reveal style="--reveal-delay: 160">
			막힌 지점, 돌아간 길, 다음에 다시 쓸 방법. 잊어버리기 전에 적어둡니다.
		</p>
	</section>

	<section class="posts" data-reveal style="--reveal-delay: 220">
		{
			posts.map((post) => (
				<article class="post">
					<a href={`/blog/${post.id}/`}>
						<div class="meta">
							<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="tags">
									{post.data.tags.slice(0, 3).map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</div>
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
						<span class="go">
							읽기
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="5" y1="12" x2="19" y2="12" />
								<polyline points="12 5 19 12 12 19" />
							</svg>
						</span>
					</a>
				</article>
			))
		}

		{posts.length === 0 && <p class="empty">아직 쓴 글이 없어요.</p>}
	</section>
</Layout>

<style>
	.head {
		padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(2rem, 5vw, 3rem);
	}

	.head h1 {
		margin: 0 0 1.25rem;
	}

	.posts {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--border);
		padding-bottom: 2rem;
	}

	.post a {
		display: block;
		padding: 1.75rem 0.5rem;
		border-bottom: 1px solid var(--border);
		color: var(--text);
		transition: background 0.3s var(--ease-soft), padding 0.35s var(--ease-out);
	}

	.post a:hover {
		background: rgba(255, 255, 255, 0.022);
		padding-inline: 1rem;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.6rem;
	}

	.meta time {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--text-mute);
	}

	.tags {
		display: flex;
		gap: 0.35rem;
	}

	.post h2 {
		font-size: clamp(1.2rem, 2.6vw, 1.5rem);
		margin: 0 0 0.45rem;
		letter-spacing: -0.03em;
	}

	.post p {
		margin: 0 0 0.9rem;
		color: var(--text-mute);
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.go {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--lamp);
	}

	.go svg {
		transition: transform 0.3s var(--ease-out);
	}

	.post a:hover .go svg {
		transform: translateX(3px);
	}

	.empty {
		padding: 3rem 0;
		color: var(--text-mute);
	}
</style>
