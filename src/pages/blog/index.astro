---
/* 블로그 첫 화면 — 홈과 같은 규칙이다. 세로로 쌓지 않고 한 화면에 담는다.
   글은 옆으로 늘어선 선반 위에 서고, 넘치면 좌우로만 움직인다.
   줄(분류)은 위쪽 알약이 맡는다 — 누르면 그 줄만 모인 선반으로 간다. */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import PostShelf from '../../components/PostShelf.astro';
import PostCard from '../../components/PostCard.astro';
import FeaturedPost from '../../components/FeaturedPost.astro';
import { byNewest, pickFeatured } from '../../lib/blog';

const posts = await getCollection('blog');
const featured = posts.length > 0 ? pickFeatured(posts) : null;

/* 큰 카드로 선 글은 뒤에서 한 번 더 보여주지 않는다 */
const rest = posts.filter((p) => p.id !== featured?.id).sort(byNewest);
---

<Layout
	title="작업 기록 · my-site"
	description="게임 만들면서 마주친 문제와 그걸 푸는 과정을 기록합니다."
	width="wide"
	fit={true}
>
	<header class="head">
		<div class="titles">
			<h1 data-reveal>
				만든 것, <span class="accent">배운 것.</span>
			</h1>
			<p class="lead" data-reveal style="--reveal-delay: 80">
				막힌 지점, 돌아간 길, 다음에 다시 쓸 방법.
			</p>
		</div>

		<div data-reveal style="--reveal-delay: 140"><BlogNav active="all" /></div>
	</header>

	<div class="stage" data-reveal style="--reveal-delay: 200">
		{
			posts.length > 0 ? (
				<PostShelf label="작업 기록">
					{featured && <FeaturedPost post={featured} variant="shelf" />}
					{rest.map((post) => (
						<PostCard post={post} variant="shelf" level={2} />
					))}
				</PostShelf>
			) : (
				<p class="empty">아직 쓴 글이 없어요.</p>
			)
		}
	</div>
</Layout>

<style>
	/* 머리는 한 줄로 눕힌다 — 여기서 아낀 세로가 그대로 카드 높이가 된다 */
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--s-5);
		flex-wrap: wrap;
		padding: clamp(1.5rem, 3.5vw, 2.75rem) 0 clamp(1rem, 2.5vw, 1.5rem);
	}

	.titles h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.75rem, 3.6vw, 2.9rem);
	}

	.titles .lead {
		margin: 0;
		font-size: var(--fs-sm);
	}

	/* 분류 알약 아래 여백은 선반이 가져간다 */
	.head :global(.bnav) {
		padding-bottom: 0;
	}

	.stage {
		min-height: 0;
		/* 격자 칸의 기본 min-width: auto 를 풀어야 안쪽 가로 스크롤이 칸을 밀어내지 않는다 */
		min-width: 0;
	}

	.empty {
		padding: 3rem 0;
		color: var(--text-mute);
	}

	@media (max-width: 720px) {
		.head {
			align-items: flex-start;
			gap: var(--s-4);
		}
	}
</style>
