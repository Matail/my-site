---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import Hero from '../components/Hero.astro';

const games = (await getCollection('games'))
	.sort((a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf())
	.slice(0, 3);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const playable = games.filter((g) => g.data.status === 'published').length;
---

<Layout intro={true}>
	<Hero playable={playable} posts={posts.length} />

	<!-- ===== 게임 ===== -->
	<section class="block" data-reveal style="--reveal-delay: 120">
		<div class="block-head">
			<div>
				<p class="kicker">GAMES</p>
				<h2>지금 놀 수 있는 것</h2>
			</div>
			<a href="/games" class="link-line more">전체 보기 →</a>
		</div>

		<div class="game-grid">
			{games.map((game) => <GameCard game={game} />)}
		</div>
	</section>

	<!-- ===== 작업 기록 ===== -->
	<section class="block" data-reveal style="--reveal-delay: 120">
		<div class="block-head">
			<div>
				<p class="kicker">DEVLOG</p>
				<h2>만들면서 남긴 것</h2>
			</div>
			<a href="/blog" class="link-line more">전체 보기 →</a>
		</div>

		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('ko-KR', {
									year: 'numeric',
									month: '2-digit',
									day: '2-digit',
								})}
							</time>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
							<span class="arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<!-- ===== 지금 하는 일 ===== -->
	<section class="now card" data-reveal style="--reveal-delay: 120">
		<p class="kicker">NOW</p>
		<p class="now-text">
			Unity로 다음 게임을 만들고 있어요. 작은 게임 하나가 누군가의 5분을 즐겁게 만들면,
			그걸로 충분하다고 생각합니다.
		</p>
		<a href="/about" class="link-line">더 읽기 →</a>
	</section>
</Layout>

<style>
	/* ===== 섹션 공통 ===== */
	.block {
		padding: clamp(2.5rem, 6vw, 4rem) 0;
	}

	.block-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.block-head h2 {
		margin: 0;
	}

	.more {
		font-size: 0.9rem;
		white-space: nowrap;
		color: var(--text-dim);
	}

	.game-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
		gap: 1.1rem;
	}

	/* ===== 글 목록 ===== */
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}

	.post-list a {
		display: grid;
		grid-template-columns: 7.5rem 1fr auto;
		align-items: baseline;
		gap: 0 1.5rem;
		padding: 1.4rem 0.5rem;
		border-bottom: 1px solid var(--border);
		color: var(--text);
		transition: background 0.3s var(--ease-soft), padding 0.3s var(--ease-out);
	}

	.post-list a:hover {
		background: rgba(255, 255, 255, 0.022);
		padding-left: 1rem;
	}

	.post-list time {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-mute);
		letter-spacing: 0.02em;
	}

	.post-list h3 {
		margin: 0 0 0.25rem;
		font-size: 1.08rem;
		font-weight: 700;
	}

	.post-list p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-mute);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-list .arrow {
		color: var(--text-mute);
		transition: transform 0.3s var(--ease-out), color 0.3s;
	}

	.post-list a:hover .arrow {
		color: var(--lamp);
		transform: translateX(4px);
	}

	/* ===== NOW ===== */
	.now {
		padding: clamp(1.75rem, 4vw, 2.5rem);
		margin-bottom: 1rem;
	}

	.now-text {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.6;
		letter-spacing: -0.02em;
		max-width: 46ch;
		margin: 0 0 1rem;
	}

	@media (max-width: 720px) {
		.post-list a {
			grid-template-columns: 1fr auto;
			gap: 0.35rem 1rem;
		}
		.post-list time {
			grid-column: 1 / -1;
		}
	}
</style>
