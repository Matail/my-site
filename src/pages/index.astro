---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GameDeck from '../components/GameDeck.astro';
import Hero from '../components/Hero.astro';

/* 홈에는 두 가지만 있다: 한 문장짜리 히어로, 그리고 게임 덱.
   덱에는 게임만 들어간다. 놀 수 있는 것부터 앞에 두고, 그 다음이 준비 중인 것.
   (출시일만으로 정렬하면 미래 날짜인 "준비 중"이 맨 앞으로 와 버린다) */
const rank = { published: 0, wip: 1, planned: 2 };
const games = (await getCollection('games')).sort((a, b) => {
	const r = rank[a.data.status] - rank[b.data.status];
	return r !== 0 ? r : b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf();
});
---

<Layout intro={true} fit={true} header={false}>
	<Hero />

	<!-- 게임 덱 — 이 페이지의 본론.
	     data-reveal 을 씌우지 않는다: 덱은 화면에 들어올 때
	     카드를 한 장씩 깔아 놓는 자기 등장 연출을 따로 갖고 있다. -->
	<GameDeck games={games} />
</Layout>
