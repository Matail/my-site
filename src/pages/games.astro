---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';

const all = (await getCollection('games')).sort(
	(a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf()
);

const playable = all.filter((g) => g.data.status === 'published');
const upcoming = all.filter((g) => g.data.status !== 'published');
---

<Layout
	title="게임 — my-site"
	description="브라우저에서 바로 즐길 수 있는 게임들. 설치도 가입도 없이 클릭 한 번."
	active="games"
>
	<section class="head">
		<p class="kicker" data-reveal>GAMES</p>
		<h1 data-reveal style="--reveal-delay: 80">
			만든 것들,<br />
			<span class="accent">놀러와요.</span>
		</h1>
		<p class="lead" data-reveal style="--reveal-delay: 160">
			전부 브라우저에서 바로 돌아갑니다. 링크를 누르면 그 자리에서 시작.
		</p>
	</section>

	<section class="list" data-reveal style="--reveal-delay: 220">
		<div class="list-head">
			<h2>지금 플레이 가능</h2>
			<span class="count">{playable.length}</span>
		</div>
		<div class="grid">
			{playable.map((game) => <GameCard game={game} detailed />)}
		</div>
	</section>

	{
		upcoming.length > 0 && (
			<section class="list" data-reveal style="--reveal-delay: 260">
				<div class="list-head">
					<h2>만드는 중</h2>
					<span class="count">{upcoming.length}</span>
				</div>
				<div class="grid">
					{upcoming.map((game) => (
						<GameCard game={game} detailed />
					))}
				</div>
			</section>
		)
	}
</Layout>

<style>
	.head {
		padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(2rem, 5vw, 3rem);
	}

	.head h1 {
		margin: 0 0 1.25rem;
	}

	.list {
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	.list-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--border);
	}

	.list-head h2 {
		margin: 0;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}

	.count {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-mute);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 1px 8px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.1rem;
	}
</style>
