---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';

interface Props {
	title?: string;
	description?: string;
	/** 현재 페이지 (헤더 메뉴 강조용) */
	active?: 'games' | 'blog' | 'about' | null;
	/** 3D 인트로 재생 (홈에서만) */
	intro?: boolean;
	/** 본문 폭 — 글 읽는 페이지는 narrow */
	width?: 'wide' | 'narrow';
	/** 한 화면에 딱 맞춘다 (홈). 스크롤이 없다 */
	fit?: boolean;
	/** 상단 헤더를 두지 않는다 (홈). 화면에는 제목과 카드뿐이다 */
	header?: boolean;
}

const {
	title = 'my-site · 심야 작업실',
	description = '한 명이 만드는 작은 게임 스튜디오. 브라우저에서 바로 즐길 수 있는 게임을 만들고, 만드는 과정을 기록합니다.',
	active = null,
	intro = false,
	width = 'wide',
	fit = false,
	header = true,
} = Astro.props;
---

<!doctype html>
<html lang="ko" data-fit={fit ? '' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0A0A0F" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>

		<title>{title}</title>

		<!-- 인트로 재생 여부를 첫 페인트 전에 결정한다 (깜빡임 방지) -->
		<script is:inline define:vars={{ intro }}>
			(function () {
				var el = document.documentElement;
				var on = false;
				if (intro) {
					try {
						var seen = sessionStorage.getItem('intro-played') === '1';
						var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						var replay = location.hash === '#intro' || location.search.indexOf('intro=1') > -1;
						on = replay || (!seen && !reduce);
					} catch (e) {
						on = false;
					}
				}
				el.dataset.intro = on ? 'on' : 'off';

				// 인트로를 실제로 틀 때만 스프라이트를 미리 받는다 (재방문자에겐 낭비 안 되게)
				if (on) {
					['south', 'east', 'south-east', 'walk-0', 'walk-1', 'walk-2', 'walk-3'].forEach(function (n) {
						var link = document.createElement('link');
						link.rel = 'preload';
						link.as = 'image';
						link.href = '/sprites/' + n + '.png';
						document.head.appendChild(link);
					});
				}
			})();
		</script>
	</head>
	<body>
		{intro && <Intro />}

		<div class="page" id="page">
			{header && <Header active={active} />}
			<main class:list={['main', width]}>
				<slot />
			</main>
			<Footer compact={fit} />
		</div>
	</body>
</html>

<style is:global>
	/* ===== 한 화면에 딱 맞추기 (홈) =====
	   헤더 / 본문 / 구석 푸터를 100dvh 안에 나눠 갖는다. 스크롤이 없다.
	   #page 로 한정하는 게 중요하다 — 인트로의 노트북 화면 안에도 같은 .main 이 들어 있어서
	   전역으로 걸면 화면 속 사이트의 레이아웃까지 바뀐다. */
	html[data-fit] {
		overflow: hidden;
	}

	html[data-fit] #page {
		height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
	}

	/* 헤더가 없는 홈 — 본문 / 아이콘 푸터 두 줄이다 */
	html[data-fit] #page:has(> .main:first-child) {
		grid-template-rows: 1fr auto;
	}

	html[data-fit] #page > .main {
		min-height: 0;
		display: grid;
		grid-template-rows: auto 1fr;
		padding-bottom: 0;
	}

	/* 다 넣기엔 너무 낮은 화면(가로로 누운 폰, 작은 노트북)에서는 스크롤을 돌려준다.
	   억지로 맞추면 카드가 우표만 해진다. */
	@media (max-height: 560px) {
		html[data-fit] {
			overflow: visible;
		}
		html[data-fit] #page {
			height: auto;
			display: block;
		}
		html[data-fit] #page > .main {
			display: block;
			padding-bottom: clamp(2rem, 6vw, 4rem);
		}
	}

	/* 인트로가 도는 동안엔 본문을 잠가둔다 */
	html[data-intro='on'] body {
		overflow: hidden;
	}
	html[data-intro='on'] #page {
		opacity: 0;
		pointer-events: none;
	}
	html.site-revealed #page {
		opacity: 1;
		transition: opacity 0.5s var(--ease-soft);
	}

	/* 인트로를 끝까지 본 경우엔 노트북 화면 속에서 이미 같은 화면을 보고 있었으므로
	   페이드 없이 한 프레임에 넘긴다 (겹쳐 페이드하면 중간에 한 번 어두워진다). */
	html.site-revealed.instant-reveal #page {
		transition: none;
	}
</style>
