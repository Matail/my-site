{
	// Cloudflare Workers 배포 설정.
	// 이 파일이 없으면 `wrangler deploy` 가 진입점을 못 찾아 대화형 자동설정으로 빠지고,
	// CI 에서는 그게 실패한다 (Missing entry-point to Worker script or to assets directory).
	//
	// 이 사이트는 astro build 결과가 전부 정적 파일이므로(7페이지 전부 prerender)
	// 서버 코드 없이 dist/ 를 그대로 서빙하는 assets 전용 Worker 로 올린다.
	"name": "my-site",
	"compatibility_date": "2026-09-20",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
